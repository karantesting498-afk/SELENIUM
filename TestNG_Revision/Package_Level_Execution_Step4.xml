<?xml version="1.0" encoding="UTF-8"?>

<!-- 
	
	We can simly pass package name here to execute complete package.
	
	Yes, you can use multiple package names inside the <packages> tag.
To include multiple packages in your TestNG suite configuration, you simply add multiple individual <package> elements—one for each package you want to test.

Example Configuration

xml
<test name="Executing all package test cases">
    <packages>
        <package name="com.example.tests.login" />
        <package name="com.example.tests.dashboard" />
        <package name="com.example.tests.payment" />
    </packages>
</test>


	
-->
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Package Level execution">

	<test name="Executing all package test cases">
	
		<packages>
		
			<package name="test"></package>
		</packages>
	</test>
</suite>