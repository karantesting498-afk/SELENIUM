<?xml version="1.0" encoding="UTF-8"?>


<!-- 
	
	Exclude method exclude specified test method from class.( eg: total 100 test casses; exlcude 10; result : 90 test case executed 
	
	and 10 are excluded)
	
	Include method only exceute specified emthod from the class (e.g: total 100 test cases; inlcude 5 test; 5 test method executed
	and other 95 are skipped)
	
	
-->

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">


<suite name="Method_Exclude Or Include">

	<test name="Exclude Method">
	
		<classes>
			
				<class name="test.day3">
				
					<methods>
					
						<exclude name="mobileLoginCarLoan"/>
					
					</methods>
				
				</class>
		
		</classes>
	
	
	</test>
	
	
	<test name="Include Method">
	
		<classes>
		
			<class name="test.day4">
			
				<methods>
				
					<include name="loginAPIHomeLoan"/>
				</methods>
			</class>
		
		</classes>
	
	</test>





</suite>