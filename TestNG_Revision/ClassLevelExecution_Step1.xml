<?xml version="1.0" encoding="UTF-8"?>



<!-- 
	
	
	This xml file contains code regarding the class level skipping.
	
	Create suite, add testname , add classes to execute
	
	only classes added in 
	
	   <test name="Personal Loan">
        <classes>
            <class name="test.day1"/>
            <class name = "test.day2"/>
        </classes>
    </test>
    
    like day1, day2 will be executed
	====================================================
-->


<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Loan Department">

    <test name="Personal Loan">
        <classes>
            <class name="test.day1"/>
            <class name = "test.day2"/>
        </classes>
    </test>
    
    
        <test name="Car Loan">
    	<classes>
    		<class name="test.day3"/>
    	</classes>
    
    </test>
    
    <test name="Home Loan">
    	<classes>
			<class name="test.day4"/>    	
    	</classes>
    
    </test>

</suite>


