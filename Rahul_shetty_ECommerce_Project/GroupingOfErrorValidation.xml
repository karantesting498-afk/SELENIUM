<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- 
	<suite parallel="tests" name="Suite"> to run tests in parallel
	
	<suite parallel="methods" name="Suite"> to run methods of the test class in parallel
 
	
-->
<suite parallel="tests" name="Suite">

	<groups>
	
		<run>
				<include name="ErrorHandling"/>
		</run>
	</groups>
  <test thread-count="5" name="Submit Order">
    <classes>

      <class name="Personal_Web.Rahul_shetty_ECommerce_Project.StandAloneTest3"/>
    </classes>
  </test> <!-- Test -->
  
  
   <test thread-count="5" name="Error validation Order">
    <classes>

      <class name="Personal_Web.Rahul_shetty_ECommerce_Project.ErrorValidation"/>
    </classes>
  </test> <!-- Test -->
</suite> <!-- Suite -->



      
