package Selenium.revision.date_4_Oct;

import org.openqa.selenium.WebDriver;
import org.openqa.selenium.chrome.ChromeDriver;

public class BrowserMethods_Step2 {
	WebDriver driver;

	public BrowserMethods_Step2(WebDriver driver) {
		// TODO Auto-generated constructor stub
		
		this.driver= driver;
	}	

	// Open Url
	public void openURL()
	{
		driver.get("https://tfqa.trackofarm.in");
		
		
	}
	
	//get tab title and print it
	public void getTitle()
	{
		System.out.println(driver.getTitle());
	}
	
	//get current tab url  and print it
	public void getCurrentUrl()
	{
		System.out.println(driver.getCurrentUrl());
	}
	
	//get current page source  and print it
	public void getPageSource()
	{
		System.out.println(driver.getPageSource());
	}
	
	//close current tab
	public void closeTab()
	{
		driver.close();
	}
	
	//close all  tab
	public void closeAllTab()
	{
		driver.quit();
	}
	
	//navigate to another url
	public void navigate(String url)
	{
		
	}
	
	
	public static void main(String[] args) {
		
		WebDriver driver = new ChromeDriver();

		BrowserMethods_Step2 b = new BrowserMethods_Step2(driver);

		
		b.openURL();
		b.getTitle();
		b.getCurrentUrl();
		
		
		b.getPageSource();
		b.closeTab();
		b.closeAllTab();
	}
	

}
